{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Time Is Money",
  "version": "0.1.5",
  "identifier": "io.github.reossann.time-is-money",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run build:native-messaging",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Time Is Money",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "native-messaging.config.json": "native-messaging.config.json"
    },
    "externalBin": [
      "binaries/native-messaging-host",
      "binaries/native-messaging-setup"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer/native-messaging.nsh"
      }
    }
  }
}
