{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "初期雛形の最小権限キャパビリティ。",
  "windows": ["main"],
  "permissions": [
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "notification:default",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-reload",
    "store:allow-save"
  ]
}
