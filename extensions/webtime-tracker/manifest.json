{
  "manifest_version": 3,
  "name": "Time Is Money - Web Tracker",
  "version": "0.1.0",
  "key": "",
  "description": "PCで開いているウェブアプリの利用時間を自動計測します",
  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Time Is Money - Web Tracker",
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "32": "src/icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  }
}
